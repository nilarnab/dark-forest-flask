# Firebase Realtime Database URL, e.g.
# https://darkforest-7856b-default-rtdb.firebaseio.com
FIREBASE_DATABASE_URL=

# Optional. Leave empty when Application Default Credentials are available.
FIREBASE_SERVICE_ACCOUNT_PATH=

# Comma-separated browser origins permitted to call this API.
# Add your Vercel production URL in Render, e.g. https://dark-forest-ui-1.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173

# How often the standalone worker runs a simulation tick.
SIMULATION_TICK_SECONDS=1
# Event-driven mode (recommended): clients calculate normal movement from
# curve data and the shared clock. Set true only to restore legacy location writes.
SIMULATION_WRITE_POSITIONS=false

# Fail a slow Realtime Database request quickly so the next tick can retry.
FIREBASE_HTTP_TIMEOUT_SECONDS=2

PROJECTILE_SPEED=500
PROJECTILE_RANGE=1000
# Life deducted from a target by each confirmed projectile hit.
PROJECTILE_BLAST_IMPACT=50
# The browser predicts projectiles and asks Flask to verify each predicted
# impact. Leave this false to avoid a full Firebase universe read every 0.1s.
PROJECTILE_PROCESSING_ENABLED=false
PROJECTILE_PROCESSING_SECONDS=0.1
# Retain expired projectile trajectories for delayed hit verification.
PROJECTILE_RETENTION_SECONDS=10
PROJECTILE_CLEANUP_SECONDS=1
# How long confirmed PROJECTILE_HIT events remain available to listeners.
HIT_EVENT_RETENTION_SECONDS=10
# Small world-unit allowance for client/server floating-point drift at a hit boundary.
HIT_DISTANCE_TOLERANCE=1
STAR_DEATH_BLAST_RADIUS=200
STAR_DEATH_BLAST_DAMAGE=100

# Flask keeps a universe simulated only while it receives a recent browser heartbeat.
UNIVERSE_ACTIVITY_TIMEOUT_SECONDS=45

# Procedural new-universe generation.
UNIVERSE_STAR_COUNT=20
UNIVERSE_STAR_DISTANCE_TARGET=500
UNIVERSE_STAR_DISTANCE_MIN=100
UNIVERSE_STAR_DISTANCE_MAX=2000
UNIVERSE_STAR_PLACEMENT_ATTEMPTS=100
UNIVERSE_SHIP_COUNT=3
UNIVERSE_SHIP_COUNT_MAX=3
UNIVERSE_SHIP_ORBIT_RADIUS=150
UNIVERSE_SHIP_ORBIT_VELOCITY=20
UNIVERSE_GUN_VELOCITY=300
UNIVERSE_GUN_HIT_RADIUS=20
UNIVERSE_STAR_LIFE=1000
UNIVERSE_SHIP_LIFE=200
UNIVERSE_STAR_BORDER_RADIUS=2
UNIVERSE_SHIP_BORDER_RADIUS=2

# Maximum allowed difference between the UI's simulation time and Flask's
# simulation time when a shot is fired. Requests outside this window are
# rejected rather than persisted with a forged timestamp.
CLIENT_FIRE_TIME_TOLERANCE_SECONDS=1

# Set to false if this instance should only expose the Flask API.
SIMULATION_ENABLED=true
